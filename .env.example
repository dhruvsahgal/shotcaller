# Copy to .env locally. Railway uses service variables instead.
DATA_DIR=.runtime
APP_TOKEN=
YAHOO_LEAGUE_ID=12345
EXPECTED_TEAMS=10
MAX_PAGES=40
HOST=127.0.0.1
PORT=3030
# Optional remote Chromium CDP websocket/HTTP URL. Keep this secret.
BROWSER_CDP_URL=
# Optional; no decisions or provider spending until both are configured.
LLM_MODEL=
LLM_API_KEY=
LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
# Durable cap on attempted provider calls until an operator reviews the ledger.
MODEL_CALL_BUDGET=50
# Optional private-volume quota in bytes for dashboard visibility. Zero means unknown.
DATA_QUOTA_BYTES=0
# Optional collector broker credential, distinct from APP_TOKEN, at least 24 characters.
# Keep in Railway and an isolated trusted upload broker, never the browser/agent environment.
COLLECTOR_TOKEN=
# API automation Run endpoint and secret copied from boxes.dev. Both remain in Railway.
BOXES_RUN_URL=
BOXES_AUTOMATION_SECRET=
BOXES_COLLECTOR_THREAD_ID=
BOXES_AUTOMATION_ID=
# Only after recorded Test A/B, mutation guard, broker isolation and restore proof.
# Schedule still starts paused; this is operator attestation, not automatic verification.
COLLECTOR_GATES_VERIFIED=false
FULL_LEAGUE_COLLECTOR_GATES_VERIFIED=false
# APPROVAL_TOKEN is entered by the manager for one exact authorization.
# EXECUTOR_TOKEN belongs only to the isolated executor, never the collector.
APPROVAL_TOKEN=
EXECUTOR_TOKEN=
ACTION_SIGNING_KEY=
ACTION_MODE=shadow
ACTION_GATES_VERIFIED=false
ACTION_ENABLED_CLASSES=
BOXES_EXECUTOR_THREAD_ID=
