# Copy to .env locally. Railway uses service variables instead.
DATA_DIR=.runtime
APP_TOKEN=
YAHOO_LEAGUE_ID=12345
EXPECTED_TEAMS=10
MAX_PAGES=40
HOST=127.0.0.1
PORT=3030
# Optional remote Chromium CDP websocket/HTTP URL. Keep this secret.
BROWSER_CDP_URL=
# Optional; no decisions or provider spending until both are configured.
LLM_MODEL=
LLM_API_KEY=
LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
